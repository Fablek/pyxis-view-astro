---
import '../styles/global.css';
import type { PyxisSeo } from '@/lib/pyxis/types';
import { fetchSite } from '@/lib/pyxis/client';
import { getTranslations } from '@/lib/translations';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  seo?: PyxisSeo;
  isPreview?: boolean;
}

const { title, seo, isPreview = false } = Astro.props;

const site = await fetchSite();
const t = getTranslations(site.language);

// An SEO title set by the editor is used as is; otherwise the page title gets the site name.
const metaTitle = seo?.title ?? `${title} | Pyxis CMS`;
const shareTitle = seo?.title ?? title;
const image = seo?.og_image;
---
<html lang={site.language} class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    {seo?.description && <meta name="description" content={seo.description} />}
    {(seo?.noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={shareTitle} />
    {seo?.description && <meta property="og:description" content={seo.description} />}
    {image?.url && (
      <>
        <meta property="og:image" content={image.url} />
        {image.width && <meta property="og:image:width" content={String(image.width)} />}
        {image.height && <meta property="og:image:height" content={String(image.height)} />}
        {image.alt && <meta property="og:image:alt" content={image.alt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400;500&display=swap" />
</head>
<body class="flex min-h-screen flex-col bg-white font-sans text-ink antialiased">
    {isPreview && (
        <div class="flex items-center justify-center gap-4 bg-accent py-2 font-mono text-xs uppercase tracking-[0.14em] text-white">
            {t.previewActive}
            <a href="/api/exit-preview" class="underline hover:no-underline">{t.exitPreview}</a>
        </div>
    )}

    <Header menuLabel={t.menu} />

    <main class="flex-1">
        <slot />
    </main>

    <Footer t={t} />
</body>
</html>
