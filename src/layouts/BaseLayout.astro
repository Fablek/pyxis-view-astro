---
import '../styles/global.css';
import type { PyxisSeo } from '@/lib/pyxis/types';
import { fetchSite } from '@/lib/pyxis/client';
import { getTranslations } from '@/lib/translations';

interface Props {
  title: string;
  seo?: PyxisSeo;
  isPreview?: boolean;
}

const { title, seo, isPreview = false } = Astro.props;

const site = await fetchSite();
const t = getTranslations(site.language);

// An SEO title set by the editor is used as is; otherwise the page title gets the site name.
const metaTitle = seo?.title ?? `${title} | Pyxis CMS`;
const shareTitle = seo?.title ?? title;
const image = seo?.og_image;
---
<html lang={site.language}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
        <title>{metaTitle}</title>
    {seo?.description && <meta name="description" content={seo.description} />}
    {(seo?.noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={shareTitle} />
    {seo?.description && <meta property="og:description" content={seo.description} />}
    {image?.url && (
      <>
        <meta property="og:image" content={image.url} />
        {image.width && <meta property="og:image:width" content={String(image.width)} />}
        {image.height && <meta property="og:image:height" content={String(image.height)} />}
        {image.alt && <meta property="og:image:alt" content={image.alt} />}
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
</head>
<body class="bg-gray-50 text-gray-900 flex flex-col min-h-screen">
    
    {isPreview && (
        <div class="bg-amber-400 text-black py-1 text-center text-xs font-bold uppercase tracking-widest flex justify-center items-center gap-4">
            {t.previewActive}
            <a href="/api/exit-preview" class="underline hover:no-underline font-black">{t.exitPreview}</a>
        </div>
    )}
    
    <nav class="bg-white border-b border-gray-200 py-4 shadow-sm">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <a href="/" class="text-xl font-bold text-indigo-600 tracking-tight">Pyxis CMS</a>
            <div class="space-x-4 text-sm font-medium text-gray-600">
                <a href="/" class="hover:text-indigo-600 transition">{t.home}</a>
            </div>
        </div>
    </nav>

    <main class="flex-1">
        <slot />
    </main>

    <footer class="bg-white border-t border-gray-200 py-8">
        <div class="container mx-auto px-4 text-center">
            <p class="text-gray-500 text-sm">
                &copy; {new Date().getFullYear()} Pyxis CMS. {t.builtWith}
            </p>
        </div>
    </footer>
</body>
</html>
