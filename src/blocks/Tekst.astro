---
import type { PyxisBlock } from '@/lib/pyxis/types';
import { container } from '@/lib/ui';

interface Props {
  block: PyxisBlock<{
    naglowek: string | null;
    tresc: string | null;
  }>;
}

const { naglowek, tresc } = Astro.props.block.data;
---

<section class="border-b border-neutral-200 py-16">
  <div class={`${container} grid gap-6 md:grid-cols-[1fr_2fr] md:gap-12`}>
    <div>{naglowek && <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">{naglowek}</h2>}</div>
    {/* HTML from the CMS rich editor, written by the site's editors. */}
    {tresc && <div class="pyxis-prose max-w-2xl" set:html={tresc} />}
  </div>
</section>
