---
import type { PyxisBlock } from '../lib/pyxis/types';

interface Props {
  block: PyxisBlock<{
    section_title: string | null;
    test: string | null;
  }>;
}

const { section_title, test } = Astro.props.block.data;
---

<section class="my-10 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200">
  {section_title && <h2 class="text-3xl font-bold text-gray-900">{section_title}</h2>}
  {test && <p class="mt-3 text-lg text-gray-600">{test}</p>}
</section>