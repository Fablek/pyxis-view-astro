---
import type { PyxisBlock } from '@/lib/pyxis/types';
import { container } from '@/lib/ui';

interface Props {
  block: PyxisBlock<{
    section_title: string | null;
    test: string | null;
  }>;
}

const { section_title, test } = Astro.props.block.data;
---

<section class="border-b border-neutral-200 py-12">
  <div class={`${container} grid gap-4 md:grid-cols-[1fr_2fr] md:gap-12`}>
    <div>{section_title && <h2 class="text-2xl font-semibold text-ink">{section_title}</h2>}</div>
    {test && <p class="text-lg text-neutral-600">{test}</p>}
  </div>
</section>
