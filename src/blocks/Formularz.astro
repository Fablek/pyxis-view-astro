---
import type { PyxisBlock } from '@/lib/pyxis/types';
import { fetchSite } from '@/lib/pyxis/client';
import { getTranslations } from '@/lib/translations';
import { container, label } from '@/lib/ui';

/** Form definition returned by the "Formularz" field of the pyxis-forms plugin. */
interface PyxisForm {
  id: string;
  title: string;
  fields: {
    type: 'text' | 'email' | 'textarea' | 'select' | 'checkbox';
    name: string;
    label: string;
    required: boolean;
    options: string[] | null;
  }[];
  honeypot: string;
  submit_url: string;
}

interface Props {
  block: PyxisBlock<{
    formularz: PyxisForm | null;
  }>;
}

const form = Astro.props.block.data.formularz;
const t = getTranslations((await fetchSite()).language);
const inputClass = 'w-full border border-neutral-300 bg-white px-4 py-3 text-ink focus:border-ink focus:outline-none';
---

{form && (
  <section class="py-14 md:py-16">
  <div class={`${container} grid gap-8 md:grid-cols-[1fr_2fr] md:gap-12`}>
  <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-3xl">{form.title}</h2>
  <div class="max-w-2xl">

    <form
      data-pyxis-form
      data-submit-url={form.submit_url}
      data-error-message={t.formError}
      class="space-y-5"
      novalidate
    >
      {form.fields.map((field) => (
        <div>
          {field.type === 'checkbox' ? (
            <label class="flex items-center gap-3">
              <input type="checkbox" name={field.name} value="1" required={field.required} class="h-4 w-4 accent-ink" />
              <span class="text-ink">{field.label}</span>
            </label>
          ) : (
            <>
              <label for={`${form.id}-${field.name}`} class={`${label} mb-2 block text-neutral-500`}>
                {field.label}{field.required && <span class="text-accent"> *</span>}
              </label>
              {field.type === 'textarea' ? (
                <textarea id={`${form.id}-${field.name}`} name={field.name} rows="5" required={field.required} class={inputClass} />
              ) : field.type === 'select' ? (
                <select id={`${form.id}-${field.name}`} name={field.name} required={field.required} class={inputClass}>
                  <option value="">—</option>
                  {(field.options ?? []).map((option) => <option value={option}>{option}</option>)}
                </select>
              ) : (
                <input id={`${form.id}-${field.name}`} type={field.type} name={field.name} required={field.required} class={inputClass} />
              )}
            </>
          )}
          <p data-error-for={field.name} class="mt-1 hidden text-sm text-accent"></p>
        </div>
      ))}

      {/* Spam trap: bots fill it in, people do not see it. */}
      <input type="text" name={form.honeypot} tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

      <button type="submit" class="border border-ink bg-ink px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-neutral-700 disabled:opacity-60">
        {t.formSubmit}
      </button>

      <p data-form-status role="status" class="hidden px-4 py-3"></p>
    </form>
  </div>
  </div>
  </section>
)}

<script>
  /**
   * Sends every form rendered by the Formularz block to the pyxis-forms API and shows the result.
   */
  document.querySelectorAll<HTMLFormElement>('form[data-pyxis-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const status = form.querySelector<HTMLElement>('[data-form-status]')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const values = Object.fromEntries(new FormData(form));

      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((error) => error.classList.add('hidden'));
      status.classList.add('hidden');
      button.disabled = true;

      const showStatus = (message: string, isSuccess: boolean) => {
        status.textContent = message;
        status.className = `border px-4 py-3 ${isSuccess ? 'border-ink text-ink' : 'border-accent text-accent'}`;
      };

      try {
        const response = await fetch(form.dataset.submitUrl!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(values),
        });
        const result = await response.json();

        if (response.ok) {
          form.reset();
          showStatus(result.message, true);
        } else if (response.status === 422) {
          Object.entries(result.errors as Record<string, string[]>).forEach(([name, messages]) => {
            const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

            if (error) {
              error.textContent = messages[0];
              error.classList.remove('hidden');
            }
          });
        } else {
          showStatus(result.message ?? form.dataset.errorMessage, false);
        }
      } catch {
        showStatus(form.dataset.errorMessage!, false);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
