---
import type { PyxisBlock } from '@/lib/pyxis/types';
import { container, label } from '@/lib/ui';

interface Props {
  block: PyxisBlock<{
    tytul: string | null;
    jezyk: string | null;
    kod: string | null;
    opis: string | null;
  }>;
}

const { tytul, jezyk, kod, opis } = Astro.props.block.data;
---

{kod && (
  <section class="border-b border-neutral-200 py-14">
    <div class={`${container} grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-12`}>
      <div>
        {jezyk && <p class={`${label} text-accent`}>{jezyk}</p>}
        {tytul && <h2 class="mt-3 break-words font-mono text-lg text-ink">{tytul}</h2>}
        {opis && <p class="mt-4 leading-relaxed text-neutral-600">{opis}</p>}
      </div>
      <pre class="overflow-x-auto border border-ink bg-ink p-6 font-mono text-[0.8125rem] leading-relaxed text-neutral-100"><code>{kod}</code></pre>
    </div>
  </section>
)}
