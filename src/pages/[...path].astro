---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/pyxis/BlockRenderer.astro';
import { fetchPage } from '../lib/pyxis/api';

const { path } = Astro.params;
const previewToken = Astro.cookies.get('pyxis_preview')?.value;

const page = await fetchPage(path, previewToken);

if (!page) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={page.title} isPreview={page.is_preview}>
  <div class="container mx-auto px-4 py-12">
    <header class="mb-12">
      <h1 class="text-5xl font-black text-gray-900 mb-4">{page.title}</h1>
      <div class="h-1 w-20 bg-indigo-500"></div>
    </header>

    <BlockRenderer blocks={page.content} isPreview={page.is_preview} />
  </div>
</BaseLayout>