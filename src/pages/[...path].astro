---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '@/lib/pyxis/components/BlockRenderer.astro';
import PageHeader from '@/components/PageHeader.astro';
import { fetchPage } from '@/lib/pyxis/client';
import { staticFields } from '@/blocks';

const { path } = Astro.params;
const previewToken = Astro.cookies.get('pyxis_preview')?.value;

const page = await fetchPage(path, previewToken);

// Renders the 404 page under the requested address, with the 404 status (no redirect).
if (!page) {
  return Astro.rewrite('/404');
}

// A page that starts with a hero block shows its heading there instead of a separate page title.
const startsWithHero = page.content?.[0]?.type === 'hero';
const fieldGroups = Object.entries(page.fields ?? {}).filter(([slug]) => staticFields[slug]);
---

<BaseLayout title={page.title} seo={page.seo} isPreview={page.is_preview}>
  {!startsWithHero && <PageHeader title={page.title} path={page.full_url} />}

  <BlockRenderer blocks={page.content} isPreview={page.is_preview} />

  {fieldGroups.map(([slug, fields]) => {
    const Component = staticFields[slug];

    return <Component fields={fields} />;
  })}
</BaseLayout>
