---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchSite } from '@/lib/pyxis/client';
import { getTranslations } from '@/lib/translations';
import { buttonClass, container, label } from '@/lib/ui';

const t = getTranslations((await fetchSite()).language);

Astro.response.status = 404;
---

<BaseLayout title={t.notFoundTitle} seo={{ title: null, description: null, og_image: null, noindex: true }}>
  <section class="border-b border-neutral-200">
    <div class={`${container} py-24 md:py-32`}>
      <p class={`${label} text-accent`}>HTTP 404 · {Astro.url.pathname}</p>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight text-ink md:text-6xl">{t.notFoundTitle}</h1>
      <p class="mt-6 max-w-xl text-lg text-neutral-600">{t.notFoundText}</p>
      <a href="/" class={`mt-10 ${buttonClass('glowny')}`}>{t.backHome} <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
