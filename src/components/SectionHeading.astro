---
import { label } from '@/lib/ui';

/** Heading of a block section: an optional monospaced label, the heading and an introduction. */
interface Props {
  eyebrow?: string | null;
  heading?: string | null;
  intro?: string | null;
}

const { eyebrow, heading, intro } = Astro.props;
---

{(eyebrow || heading || intro) && (
  <div class="grid gap-6 md:grid-cols-[1fr_2fr] md:gap-12">
    <div>
      {eyebrow && <p class={`${label} text-accent`}>{eyebrow}</p>}
      {heading && <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink md:text-4xl">{heading}</h2>}
    </div>
    {intro && <p class="text-lg leading-relaxed text-neutral-600 md:pt-8">{intro}</p>}
  </div>
)}
