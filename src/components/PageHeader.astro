---
import { container, label } from '@/lib/ui';

interface Props {
  title: string;
  path: string;
}

const { title, path } = Astro.props;
---

<section class="border-b border-neutral-200">
  <div class={`${container} py-16 md:py-20`}>
    <p class={`${label} text-neutral-500`}>{path}</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink md:text-5xl">{title}</h1>
  </div>
</section>
