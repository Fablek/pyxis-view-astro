---
interface Props {
  onDark?: boolean;
}

const { onDark = false } = Astro.props;
---

<a href="/" class="flex items-center gap-3 font-semibold tracking-tight">
  <img src={onDark ? '/logo-dark.svg' : '/logo.svg'} alt="" width="32" height="32" class="h-8 w-8" />
  <span class={onDark ? 'text-white' : 'text-ink'}>Pyxis CMS</span>
</a>
